{
  "name": "GameHistory",
  "type": "object",
  "properties": {
    "player_email": {
      "type": "string"
    },
    "player_user_id": {
      "type": "string",
      "description": "Stable authenticated owner id for deletion and owner-scoped reads.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "match_id": {
      "type": "string",
      "description": "Immutable server-issued identity of one played match, independent of reusable room code.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "room_code": {
      "type": "string"
    },
    "match_type": {
      "type": "string",
      "enum": [
        "online",
        "local"
      ],
      "description": "Match origin. Only online matches contribute to competitive statistics."
    },
    "ranked": {
      "type": "boolean",
      "description": "Whether this result contributes to rating and profile statistics."
    },
    "role": {
      "type": "string",
      "enum": [
        "spy",
        "detective"
      ]
    },
    "word": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "winner": {
      "type": "string",
      "enum": [
        "detectives",
        "spy"
      ]
    },
    "player_count": {
      "type": "number"
    },
    "won": {
      "type": "boolean"
    }
  },
  "required": [
    "player_email",
    "room_code",
    "role",
    "winner"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.player_user_id": "{{user.id}}" },
        { "data.player_email": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
