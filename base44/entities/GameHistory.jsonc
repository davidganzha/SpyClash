{
  "name": "GameHistory",
  "type": "object",
  "properties": {
    "player_email": {
      "type": "string"
    },
    "player_user_id": {
      "type": "string",
      "description": "Stable authenticated owner id for deletion and owner-scoped reads.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "match_id": {
      "type": "string",
      "description": "Immutable server-issued identity of one played match, independent of reusable room code.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "result_key": {
      "type": "string",
      "description": "Deterministic server result identity derived from match_id and player_user_id for idempotent archive recovery.",
      "rls": {
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "profile_repair_state": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed"
      ],
      "description": "Server-only durable Community profile repair state for this ranked result.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "profile_repair_token": {
      "type": "string",
      "maxLength": 160,
      "description": "Server-only single-flight token for Community profile repair.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "profile_repair_lease_until": {
      "type": "string",
      "format": "date-time",
      "description": "Server-only expiry of the current Community profile repair claim.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "profile_repair_attempt_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Server-only count of Community profile repair claims.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "profile_repair_completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server-only completion time for Community profile repair.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "room_code": {
      "type": "string"
    },
    "match_type": {
      "type": "string",
      "enum": [
        "online",
        "local"
      ],
      "description": "Match origin. Only online matches contribute to competitive statistics."
    },
    "ranked": {
      "type": "boolean",
      "description": "Whether this result contributes to rating and profile statistics."
    },
    "role": {
      "type": "string",
      "enum": [
        "spy",
        "detective"
      ]
    },
    "word": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "winner": {
      "type": "string",
      "enum": [
        "detectives",
        "spy"
      ]
    },
    "player_count": {
      "type": "number"
    },
    "spy_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "Frozen spy-team size used for this match."
    },
    "won": {
      "type": "boolean"
    }
  },
  "required": [
    "player_email",
    "room_code",
    "role",
    "winner"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.player_user_id": "{{user.id}}" },
        { "data.player_email": "{{user.email}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
