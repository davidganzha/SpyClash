{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": ["admin", "user"],
      "default": "user"
    },
    "display_name": {
      "type": "string",
      "description": "Player display name"
    },
    "avatar": {
      "type": "string",
      "description": "Avatar emoji or image url"
    },
    "games_played": {
      "type": "number",
      "default": 0
    },
    "games_won": {
      "type": "number",
      "default": 0
    },
    "language": {
      "type": "string",
      "description": "User's preferred language",
      "enum": ["ru", "en", "es"],
      "default": "en"
    },
    "ai_generations_today": {
      "type": "number",
      "description": "AI generations used today (resets daily)",
      "default": 0
    },
    "last_ai_generation_date": {
      "type": "string",
      "description": "ISO date of last AI generation (for daily reset)"
    },
    "spy_id": {
      "type": "string",
      "description": "Unique public SpyClash identifier in 000-000 format"
    },
    "spy_card_theme": {
      "type": "string",
      "description": "Selected SpyCard visual theme identifier",
      "default": "field"
    },
    "spy_card_accent": {
      "type": "string",
      "description": "Selected SpyCard accent identifier",
      "default": "signal_red"
    },
    "spy_card_badge": {
      "type": "string",
      "description": "Selected SpyCard badge identifier",
      "default": "operative"
    }
  },
  "required": ["role"]
}
