{
  "name": "GameRoomSignal",
  "description": "Per-participant realtime wake-up hint for an authoritative lobby revision. Clients fetch the mediated room projection after observing a signal; no room secret or raw lobby payload is stored here.",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "maxLength": 256,
      "description": "Stable authenticated recipient id."
    },
    "room_id": {
      "type": "string",
      "maxLength": 256,
      "description": "Room whose projected state should be refreshed."
    },
    "lobby_revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Latest committed authoritative lobby revision known to the signal writer."
    },
    "room_revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Latest monotonic shared-room revision represented by this signal."
    },
    "room_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "System timestamp of the latest committed room state represented by this wake-up signal."
    },
    "state": {
      "type": "string",
      "enum": ["active", "closed"],
      "description": "Whether the client should refresh an active room or discard a closed-room subscription."
    },
    "close_intent_id": {
      "type": "string",
      "maxLength": 128,
      "description": "Server-only durable receipt proving that this recipient signal was closed by an authorized room close intent.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "close_match_id": {
      "type": "string",
      "maxLength": 128,
      "description": "Server-only match identity bound to the durable room close receipt.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "close_completion": {
      "type": "object",
      "description": "Server-only tombstone written only after every participant received the exact closed signal. It carries the participant lease set needed to finish an interrupted physical deletion.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    }
  },
  "required": ["user_id", "room_id", "lobby_revision", "state"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
