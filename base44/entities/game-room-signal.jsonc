{
  "name": "GameRoomSignal",
  "description": "Per-participant realtime hint for an authoritative room revision. Most signals wake a mediated room refresh; the explicitly discriminated lobby-mode projection carries only the safe committed mode and no room secret or raw lobby payload.",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "maxLength": 256,
      "description": "Stable authenticated recipient id."
    },
    "room_id": {
      "type": "string",
      "maxLength": 256,
      "description": "Room whose projected state should be refreshed."
    },
    "lobby_revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Latest committed authoritative lobby revision known to the signal writer."
    },
    "room_revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Latest monotonic shared-room revision represented by this signal."
    },
    "room_updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "System timestamp of the latest committed room state represented by this wake-up signal."
    },
    "state": {
      "type": "string",
      "enum": ["active", "closed"],
      "description": "Whether the client should refresh an active room or discard a closed-room subscription."
    },
    "projection_kind": {
      "type": "string",
      "enum": ["none", "lobby_mode_v1"],
      "description": "Explicit discriminator for an optional safe direct projection. Missing legacy values and none require an authoritative room refresh."
    },
    "projection_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique id of this direct projection emission. Clients use it only when projection_kind is lobby_mode_v1."
    },
    "projected_game_mode": {
      "type": "string",
      "enum": ["questions", "associations"],
      "description": "Safe committed lobby mode carried only by a lobby_mode_v1 projection."
    },
    "projection_committed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server-side post-CAS timestamp approximation captured when the direct projection is constructed. It never reuses a potentially stale pre-CAS room updated_date."
    },
    "projection_emitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server emission timestamp used with projection_id to order repeated projections at one room revision."
    },
    "close_intent_id": {
      "type": "string",
      "maxLength": 128,
      "description": "Server-only durable receipt proving that this recipient signal was closed by an authorized room close intent.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "close_match_id": {
      "type": "string",
      "maxLength": 128,
      "description": "Server-only match identity bound to the durable room close receipt.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "close_completion": {
      "type": "object",
      "description": "Server-only tombstone written only after every participant received the exact closed signal. It carries the participant lease set needed to finish an interrupted physical deletion.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    }
  },
  "required": ["user_id", "room_id", "lobby_revision", "state"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": {
      "$or": [
        { "data.user_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
