{
  "name": "GenerationRewardEnrollment",
  "description": "Server-only irreversible account enrollment in supported rewarded-generation policy. An omitted or downgraded client capability never restores legacy quota. Deleted with the account.",
  "type": "object",
  "properties": {
    "user_id": {"type": "string", "maxLength": 256},
    "provider": {"type": "string", "enum": ["unity"]},
    "client_build": {"type": "integer", "minimum": 228, "maximum": 2147483647},
    "enrolled_at": {"type": "string", "format": "date-time"}
  },
  "required": ["user_id", "provider", "client_build", "enrolled_at"],
  "rls": {
    "create": {"user_condition": {"role": "admin"}},
    "read": {"user_condition": {"role": "admin"}},
    "update": {"user_condition": {"role": "admin"}},
    "delete": {"user_condition": {"role": "admin"}}
  }
}
