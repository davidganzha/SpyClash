{
  "name": "MembershipSignal",
  "description": "Owner-scoped realtime hint to refetch verified membership. Contains no transaction, payment or entitlement data.",
  "type": "object",
  "properties": {
    "user_id": { "type": "string", "maxLength": 256 },
    "change_id": { "type": "string", "maxLength": 64 }
  },
  "required": ["user_id", "change_id"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "$or": [
      { "data.user_id": "{{user.id}}" },
      { "user_condition": { "role": "admin" } }
    ] },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
