{
  "name": "GameRoom",
  "description": "Server-owned live room state. Clients read and mutate rooms only through gameRoomAction.",
  "type": "object",
  "properties": {
    "code": { "type": "string", "description": "6-char join code" },
    "host_email": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["waiting", "ready_voting", "roulette", "playing", "finished"],
      "default": "waiting"
    },
    "players": {
      "type": "array",
      "description": "Server-normalized player objects {user_id, email, name, avatar}",
      "items": { "type": "object" }
    },
    "participant_user_ids": {
      "type": "array",
      "description": "Stable user ids mirrored from players for authenticated lookup and lifecycle coordination",
      "items": { "type": "string" },
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "match_id": {
      "type": "string",
      "description": "Immutable server-issued identity for the current match; replaced only when a new replay starts.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "terminal_intent": {
      "type": "object",
      "description": "Immutable CAS-claimed server decision reconciled into history and final room state.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "spectators": { "type": "array", "items": { "type": "string" } },
    "ready_players": { "type": "array", "items": { "type": "string" } },
    "cards_read": { "type": "array", "items": { "type": "string" } },
    "spy_email": { "type": "string" },
    "spy_emails": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string" },
      "description": "Frozen server-selected spy team. Projected per viewer; legacy spy_email remains the primary identity."
    },
    "word": { "type": "string" },
    "category": { "type": "string" },
    "spy_guess": { "type": "string" },
    "detective_votes": { "type": "array", "items": { "type": "object" } },
    "vote_requests": { "type": "array", "items": { "type": "string" } },
    "detective_vote_round_id": {
      "type": "string",
      "maxLength": 128,
      "default": "",
      "description": "Server-issued identity for the currently active detective ballot; cleared atomically when that ballot settles."
    },
    "detective_vote_cancellation_event_id": {
      "type": "string",
      "maxLength": 128,
      "default": "",
      "description": "Durable server-issued identity for the latest synchronized early ballot-cancellation presentation."
    },
    "detective_vote_cancellation_round_id": {
      "type": "string",
      "maxLength": 128,
      "default": "",
      "description": "Identity of the detective ballot cancelled by the latest cancellation event."
    },
    "detective_vote_cancellation_present_at": {
      "type": "string",
      "default": "",
      "description": "Server ISO timestamp at which every client should present the latest cancellation event."
    },
    "detective_vote_cancellation_reason": {
      "type": "string",
      "enum": ["", "no_viable_candidate"],
      "default": "",
      "description": "Machine-readable reason for the latest synchronized detective-vote cancellation."
    },
    "winner": {
      "type": "string",
      "enum": ["detectives", "spy", ""],
      "default": ""
    },
    "round_number": { "type": "number", "default": 1 },
    "current_asker_email": { "type": "string" },
    "current_answerer_email": { "type": "string" },
    "current_answer": { "type": "string" },
    "current_answer_feedback": {
      "type": "string",
      "enum": ["like", "dislike", null]
    },
    "player_feedback": { "type": "array", "items": { "type": "object" } },
    "questions_in_round": { "type": "number", "default": 0 },
    "question_phase": {
      "type": "string",
      "enum": ["asking", "answering", "countdown", "results"],
      "default": "asking"
    },
    "eliminated_emails": { "type": "array", "items": { "type": "string" } },
    "word_pool": { "type": "array", "items": { "type": "object" } },
    "intro_started_at": {
      "type": "string",
      "description": "Server-issued timestamp anchoring the synchronized online intro."
    },
    "game_started_at": { "type": "string" },
    "game_started_event_id": {
      "type": "string",
      "description": "Opaque server event identity for the current match start notification.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "game_finished_event_id": {
      "type": "string",
      "description": "Opaque server event identity for the current match terminal notification.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "game_duration_seconds": { "type": "number", "default": 900 },
    "game_paused_at": {
      "type": "string",
      "description": "Server-issued timestamp for the currently active host pause."
    },
    "game_paused_total_seconds": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "description": "Accumulated completed pause duration used by the authoritative deadline."
    },
    "countdown_started_at": { "type": "string" },
    "roulette_target_email": { "type": "string" },
    "game_mode": {
      "type": "string",
      "enum": ["questions", "associations"],
      "default": "questions"
    },
    "lobby_spy_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "default": 1,
      "description": "Host-selected public spy count, constrained by the current player count."
    },
    "spies_know_each_other": {
      "type": "boolean",
      "default": false,
      "description": "Whether active spies may see the rest of their team before the match finishes."
    },
    "incompatible_player_emails": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string" },
      "description": "Bounded server tombstones used to return client_update_required after a host selects multiple spies.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "departed_player_emails": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string" },
      "description": "Server-only identities of players who explicitly left an active match; distinguishes departure from role ejection.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "lobby_schema_version": {
      "type": "integer",
      "minimum": 1,
      "default": 2,
      "description": "Version of the additive authoritative lobby-state contract."
    },
    "lobby_revision": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Server-incremented revision for atomic host lobby snapshots."
    },
    "room_revision": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Monotonic CAS revision for every shared room-state mutation."
    },
    "room_last_write_token": {
      "type": "string",
      "maxLength": 128,
      "description": "Internal response-loss reconciliation token for the latest room write.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "lobby_word_source": {
      "type": "string",
      "enum": ["none", "saved", "ai", "manual"],
      "default": "none"
    },
    "lobby_source_pack_id": {
      "type": "string",
      "maxLength": 128,
      "description": "Optional source-pack identity. Exposed only to the host by gameRoomAction projection."
    },
    "lobby_source_name": { "type": "string", "maxLength": 120 },
    "lobby_theme": { "type": "string", "maxLength": 120 },
    "lobby_category": { "type": "string", "maxLength": 120 },
    "lobby_word_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200,
      "default": 0
    },
    "lobby_word_count_mode": {
      "type": "string",
      "enum": ["recommended", "custom"],
      "default": "recommended"
    },
    "lobby_word_pool": {
      "type": "array",
      "maxItems": 200,
      "items": { "type": "object" },
      "description": "Server-canonical lobby draft entries {id, word, enabled}; separate from the frozen gameplay word_pool."
    },
    "lobby_last_mutation_id": {
      "type": "string",
      "maxLength": 128,
      "description": "Latest host mutation id used for bounded idempotent replay.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    },
    "lobby_last_mutation_fingerprint": {
      "type": "string",
      "maxLength": 64,
      "description": "Internal fingerprint binding the latest mutation id to its canonical snapshot.",
      "rls": {
        "read": { "user_condition": { "role": "admin" } },
        "write": { "user_condition": { "role": "admin" } }
      }
    }
  },
  "required": ["code", "host_email", "status"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
