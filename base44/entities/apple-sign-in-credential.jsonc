{
  "name": "AppleSignInCredential",
  "description": "Server-owned encrypted Sign in with Apple refresh credentials used only for account-deletion revocation.",
  "type": "object",
  "properties": {
    "identity_key": {
      "type": "string",
      "description": "Keyed one-way identifier derived from Apple's verified email claim."
    },
    "subject_key": {
      "type": "string",
      "description": "Keyed one-way identifier derived from Apple's verified subject claim."
    },
    "user_id": {
      "type": "string",
      "description": "Authenticated Base44 owner, populated only after session provisioning."
    },
    "credential_kind": {
      "type": "string",
      "enum": ["token"],
      "description": "Identifies this server-owned row as an encrypted provider credential."
    },
    "client_id": {
      "type": "string",
      "description": "Exact native App ID or web Services ID used to mint and revoke the credential."
    },
    "state": {
      "type": "string",
      "enum": ["pending", "bound", "revoking", "revoked"],
      "description": "Two-phase ownership and retry-safe revocation state."
    },
    "refresh_token_ciphertext": {
      "type": "string",
      "description": "AES-GCM encrypted Apple refresh token; cleared immediately after successful revocation."
    },
    "refresh_token_iv": {
      "type": "string",
      "description": "AES-GCM nonce bound to identity, subject, and client id."
    },
    "binding_ticket_hash": {
      "type": "string",
      "description": "One-way hash of a short-lived idempotent ticket used to bind this credential after Base44 authentication."
    },
    "binding_ticket_expires_at": {
      "type": "string",
      "description": "Expiry for the idempotent post-authentication binding ticket."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "manual_revocation_required": {
      "type": "boolean",
      "description": "Deletion receipt indicating that Apple must be disconnected manually because no usable token was available."
    },
    "revision": {
      "type": "string",
      "description": "Opaque optimistic-concurrency revision used for exact service-role updates."
    }
  },
  "required": [
    "identity_key",
    "subject_key",
    "credential_kind",
    "client_id",
    "state",
    "refresh_token_ciphertext",
    "refresh_token_iv",
    "created_at",
    "updated_at",
    "revision"
  ],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
