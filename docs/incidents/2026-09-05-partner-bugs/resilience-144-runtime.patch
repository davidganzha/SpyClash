+function safeLifecycleLogError(error: unknown) {
+  const property = (key: string): unknown => {
+    if (
+      error === null ||
+      (typeof error !== "object" && typeof error !== "function")
+    ) return undefined;
+    try {
+      return Reflect.get(error, key);
