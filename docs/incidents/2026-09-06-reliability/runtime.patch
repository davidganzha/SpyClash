+<body><main><h1>${title}</h1><p>${copy.detail}</p><a class="primary" href="${appURL}" rel="noreferrer">${copy.app}</a><a href="${websiteURL}" rel="noreferrer">${copy.website}</a><small>${copy.hint}</small></main></body></html>`,
+    { status: 400, headers },
+  );
