+export type BillingIdentityLifecycleErrorCode =
+  | "incomplete_state"
+  | "user_missing"
+  | "deletion_in_progress"
+  | "active_lease"
+  | "duplicate_records"
+  | "cas_contention"
+  | "ambiguous";
