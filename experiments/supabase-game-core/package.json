{
  "name": "spyclash-supabase-game-core-test",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "backend:start": "node scripts/local.mjs start",
    "backend:stop": "node scripts/local.mjs stop",
    "backend:status": "node scripts/local.mjs status",
    "backend:verify": "node scripts/local.mjs verify",
    "backend:apply": "node scripts/local.mjs apply",
    "test": "node scripts/local.mjs test",
    "full-core:test": "node scripts/full-core-local.mjs",
    "full-core:apply": "node scripts/full-core-local.mjs apply",
    "full-core:check": "deno check --config supabase/functions/full-game-core/deno.json supabase/functions/full-game-core/index.ts",
    "full-core:engine-test": "deno test --config supabase/functions/full-game-core/deno.json tests/full-core-engine",
    "full-core:cloud-test": "node scripts/full-core-cloud-test.mjs",
    "app:test": "node scripts/app-services-local.mjs",
    "app:apply": "node scripts/app-services-local.mjs apply",
    "app:check": "deno check --config supabase/functions/app-services/deno.json supabase/functions/app-services/index.ts supabase/functions/legacy-session/index.ts supabase/functions/app-services/legacy-social.ts scripts/legacy-social-export.ts",
    "app:cloud-test": "node scripts/app-services-cloud-test.mjs",
    "migration:check": "deno check supabase/functions/bulk-legacy-migration/index.ts scripts/bulk-migration/prepare.ts scripts/bulk-migration/attestation.ts scripts/bulk-migration/schema-inventory.ts scripts/bulk-migration/source-export-cli.ts",
    "migration:test": "deno test scripts/bulk-migration/source-export.test.ts scripts/bulk-migration/ancillary.test.ts scripts/bulk-migration/attestation.test.ts scripts/bulk-migration/schema-inventory.test.ts && node --experimental-transform-types --test scripts/bulk-migration/core.test.mjs",
    "migration:rehearse": "node --experimental-transform-types scripts/bulk-migration/rehearse.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "pg": "8.23.1",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "deno": "2.9.6",
    "supabase": "2.120.0"
  }
}
