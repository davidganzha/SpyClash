{
  "description": "Server-owned invitation from one SpyClash operative to an active online room.",
  "name": "RoomInvite",
  "properties": {
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "notification_event_id": {
      "description": "Opaque server event identity used to deduplicate this invite notification.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      },
      "type": "string"
    },
    "recipient_user_id": {
      "type": "string"
    },
    "room_code": {
      "type": "string"
    },
    "room_id": {
      "type": "string"
    },
    "sender_user_id": {
      "type": "string"
    },
    "status": {
      "default": "pending",
      "enum": [
        "pending",
        "accepted",
        "declined",
        "expired"
      ],
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "sender_user_id",
    "recipient_user_id",
    "room_id",
    "room_code",
    "status",
    "created_at",
    "updated_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}
