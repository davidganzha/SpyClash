{
  "description": "Owner-scoped realtime hint to refetch verified membership. Contains no transaction, payment or entitlement data.",
  "name": "MembershipSignal",
  "properties": {
    "change_id": {
      "maxLength": 64,
      "type": "string"
    },
    "user_id": {
      "maxLength": 256,
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "change_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}
